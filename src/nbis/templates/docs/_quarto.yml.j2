# -*- yaml -*-
project:
  type: website
  output-dir: _site
  render:
    - diary/index.qmd
  resources:
    - "*.ipynb"

author: "{{ author }}"
institute: NBIS
{% if bibliography -%}
  bibliography: {{ bibliography|default('assets/bibliography.bib') }}
{% endif %}
from: markdown+emoji
{% if csl -%}
  csl: {{ csl }}
{% endif -%}

format:
  nbis-quarto-revealjs:
    theme:
      - default
      - {{ assets|default('assets') }}/css/nbis.scss
    date: last-modified
    date-format: "DD-MMM-YYYY"
    embed-resources: false
    code-line-numbers: false
    toc: true
    toc-depth: 2
    slide-level: 2
    slide-number: true
    preview-links: true
    chalkboard: false
    smaller: false
    highlight-style: gruvbox
    fig-height: 12
    fig-width: 10
    width: 1280
    height: 720
    margin: 0.1
    navigation-mode: vertical
    reference-location: margin
    ultitle: true

  nbis-course-html:
    theme:
      - default
    date: last-modified
    date-format: "DD-MMM-YYYY"
    toc: true
    embed-resources: false
    code-line-numbers: false
    lightbox:
      match: auto
    mermaid:
      theme: neutral
  confluence-html:
    theme:
      - {{ assets|default('assets') }}/css/nbis.scss
    toc: true
    embed-resources: true
    date: last-modified
    date-format: "DD-MMM-YYYY"
    lightbox:
      match: auto

execute:
  echo: true
  warning: false
  cache: true
  include: true
  autodep: true
  eval: true
  error: true

knitr:
  opts_chunk:
    code-fold: true
    tidy: true
    fig-format: svg
    comment-char: "#>"
    engine.opts:
      dvisvgm.opts: --font-format=woff
      template: assets/www/tikzfig.tex

