logger = logging.getLogger(__name__)

CONTEXT_SETTINGS = {"auto_envvar_prefix": "{{ project_name.upper() }}", "show_default": True}

pass_environment = click.make_pass_decorator(Environment, ensure=True)


class SnakemakeCli(click.Group):
    """Custom click group for Snakemake commands."""

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self._cmd_folder = pathlib.Path(__file__).parent
        self._module = "{{ project_name }}.commands.smk"

    def list_commands(self, ctx):
        return sorted(
            f.stem
            for f in self._cmd_folder.iterdir()
            if f.suffix == ".py" and not f.name.startswith("_")
        )

    def get_command(self, ctx, cmd_name):
        try:
            mod = importlib.import_module(f"{self._module}.{cmd_name}")
        except ImportError:
            return None
        return getattr(mod, "cli", None)


@click.group(
    cls=SnakemakeCli,
    context_settings=CONTEXT_SETTINGS,
    help=__doc__,
    name="{{ project_name }}",
    invoke_without_command=True,
)
@click.version_option(version=__version__)
@options.config_file_option()
@options.debug_option()
@click.pass_context
@pass_environment
def cli(env, ctx):
    """CLI docstring for {{ project_name }}"""
    logging.basicConfig(
        level=logging.INFO, format="%(levelname)s [%(name)s:%(funcName)s]: %(message)s"
    )
    if ctx.invoked_subcommand is None:
        click.echo(ctx.get_help())
    if env.debug:
        logging.getLogger().setLevel(logging.DEBUG)
